#!/bin/sh
# Prints gleam/src/tazuna/internal/engine_pin.gleam: the package's version, the release URL, and for each platform the
# gzipped engine and z3 in the assets directory, tazuna-engine-<platform>.gz and z3-<platform>.gz, with their SHA-256.
# The release workflow runs it on the assets it built; with an empty directory it pins no platform, as the tree does
# between releases.
# Usage: scripts/engine-pin <release URL> <assets directory>
set -eu
url=$1
dir=$2
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$(dirname "$0")/../gleam/gleam.toml")
sha256() {
  if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}
# gleam format's layout, so the printed file passes gleam format --check.
release="pub const release = \"$url\""
[ ${#release} -le 80 ] || release="pub const release =
  \"$url\""
pins=
for engine in "$dir"/tazuna-engine-*.gz; do
  [ -f "$engine" ] || continue
  platform=${engine##*/tazuna-engine-}
  platform=${platform%.gz}
  z3=$dir/z3-$platform.gz
  [ -f "$z3" ] || { echo "engine-pin: $engine has no $z3 beside it" >&2; exit 1; }
  pins="$pins  Pin(
    \"$platform\",
    Asset(
      \"tazuna-engine-$platform.gz\",
      \"$(sha256 "$engine")\",
    ),
    Asset(
      \"z3-$platform.gz\",
      \"$(sha256 "$z3")\",
    ),
  ),
"
done
cat <<EOF
//// The release the launcher fetches the engine and z3 from on first run:
//// this package's version, and for each platform the gzipped executables
//// with their SHA-256.
////
//// Generated by scripts/engine-pin. DO NOT EDIT.

pub const version = "$version"

$release

pub type Asset {
  Asset(name: String, sha256: String)
}

/// A platform is named \`<os>-<arch>\` as Node names it, such as \`darwin-arm64\`.
pub type Pin {
  Pin(platform: String, engine: Asset, z3: Asset)
}

EOF
if [ -n "$pins" ]; then
  printf 'pub const pins: List(Pin) = [\n%s]\n' "$pins"
else
  echo 'pub const pins: List(Pin) = []'
fi
