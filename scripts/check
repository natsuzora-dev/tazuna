#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$HOME/.elan/bin:$PATH"

# Users run the launcher on either target, so both are built and tested. gleam test leaves the converter corpus's IR in
# gleam/build/corpus.ir.json.
(cd gleam && gleam format --check src test &&
  gleam build --target javascript --warnings-as-errors && gleam test --target javascript &&
  gleam build --target erlang --warnings-as-errors && gleam test --target erlang)
# The linters run only in modules that import them. A module with no tazuna import would miss them, so every module
# but the linters' own imports one, and the modules that import nothing else of tazuna's import Tazuna.Linter.
unlinted=$(cd lean && grep -L '^import Tazuna\.' $(find Tazuna -name '*.lean' ! -path 'Tazuna/Linter*') *.lean || true)
if [ -n "$unlinted" ]; then
  echo "These Lean modules import no tazuna module, so the linters skip them. Import Tazuna.Linter: $unlinted"
  exit 1
fi
(cd lean && lake build --wfail && lake exe gen-dsl ..)

gleam_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' gleam/gleam.toml)
lean_version=$(cd lean && lake exe tazuna-engine)
if [ "$gleam_version" != "$lean_version" ]; then
  echo "gleam/gleam.toml has version $gleam_version but the engine prints $lean_version. Make them the same."
  exit 1
fi

# Lean must load all of the corpus.
lean/.lake/build/bin/tazuna-engine check corpus/main --ir gleam/build/corpus.ir.json ||
  { echo "The engine did not load the converter corpus."; exit 1; }

# The solver must read the printed scripts and print values the engine reads back.
lean/.lake/build/bin/smt-check "$(command -v z3)" || { echo "The solver check failed (is z3 on PATH?)."; exit 1; }

# A term built twice instead of shared grows the scripts without failing a proof, so the sizes have a
# budget. Raise a budget only with the cause of the growth in the commit message.
sizes=$(lean/.lake/build/bin/smt-check --sizes lean/sizes-budget.txt) || {
  echo "$sizes" | grep '^smt-check:'
  echo "The step scripts grew past lean/sizes-budget.txt."
  exit 1
}

test/e2e/check "$PWD/lean/.lake/build/bin/kinds" "$PWD/lean/.lake/build/bin/tazuna-engine" "$PWD/gleam/build/dev"

# prove and generate print the same lines whatever --jobs is, and --only keeps the full run's lines and files.
test/determinism/check "$PWD/lean/.lake/build/bin/tazuna-engine" "$PWD/gleam/build/dev"
