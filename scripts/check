#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$HOME/.elan/bin:$PATH"

# Users run the launcher on either target, so both are built and tested. gleam test leaves the converter corpus's IR in
# gleam/build/corpus.ir.json.
(cd gleam && gleam format --check src test &&
  gleam build --target javascript --warnings-as-errors && gleam test --target javascript &&
  gleam build --target erlang --warnings-as-errors && gleam test --target erlang)
(cd lean && lake build --wfail && lake exe gen-dsl ..)

gleam_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' gleam/gleam.toml)
lean_version=$(cd lean && lake exe tazuna-engine)
if [ "$gleam_version" != "$lean_version" ]; then
  echo "gleam/gleam.toml has version $gleam_version but the engine prints $lean_version. Make them the same."
  exit 1
fi

# Lean must load all of the corpus.
lean/.lake/build/bin/tazuna-engine check corpus/main --ir gleam/build/corpus.ir.json ||
  { echo "The engine did not load the converter corpus."; exit 1; }

kinds=$(mktemp)
trap 'rm -f "$kinds"' EXIT
(cd lean && lake exe kinds) >"$kinds"
test/e2e/check "$kinds" "$PWD/lean/.lake/build/bin/tazuna-engine" "$PWD/gleam/build/dev"
