#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PATH="$HOME/.elan/bin:$PATH"

# The JavaScript target needs only node. Erlang/OTP joins when the launcher gets its Erlang FFI.
# gleam test leaves the converter corpus's IR in gleam/build/corpus.ir.json.
(cd gleam && gleam format --check src test && gleam build --target javascript --warnings-as-errors &&
  gleam test --target javascript)
(cd lean && lake build --wfail && lake exe gen-dsl ..)

gleam_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' gleam/gleam.toml)
lean_version=$(cd lean && lake exe tazuna-engine)
if [ "$gleam_version" != "$lean_version" ]; then
  echo "gleam/gleam.toml has version $gleam_version but the engine prints $lean_version. Make them the same."
  exit 1
fi

# Lean must load all of the corpus. Its root takes a tazuna.Spec instead of returning one because no built-in can build
# a Spec yet, so the root's type is the only refusal; expect a clean load once built-ins exist.
code=0
out=$(lean/.lake/build/bin/tazuna-engine check gleam/build/corpus.ir.json) || code=$?
case "$code $out" in
  '4 {"col":1,"file":"test/corpus/main.gleam","kind":"Internal.invalidIr","line":18,"message":"root corpus/main.spec has type fn(tazuna.Spec) -> tazuna.Spec; it must be fn() -> tazuna.Spec"}') ;;
  *) printf 'The engine did not load the converter corpus (exit %s):\n%s\n' "$code" "$out"; exit 1 ;;
esac

kinds=$(mktemp)
trap 'rm -f "$kinds"' EXIT
(cd lean && lake exe kinds) >"$kinds"
test/e2e/check "$kinds" "$PWD/lean/.lake/build/bin/tazuna-engine"
