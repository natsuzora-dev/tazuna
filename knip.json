{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/fixtures/*/*/*/**/*.ts", "test/fixtures/check/outside/*.ts", "scripts/stage-engine.ts"],
      "ignoreDependencies": ["@swc/core"],
      "vite": {
        "config": ["viewer/vite.config.ts"]
      }
    },
    "samples/todo/spec": {
      "entry": ["**/{scenarios,contract,automations,machines,bounds,*Screen}.ts"]
    }
  },
  "ignoreBinaries": ["lake", "mkfifo", "strip"],
  "ignoreUnresolved": ["#engine"],
  "ignoreExportsUsedInFile": {
    "type": true
  },
  "ignoreIssues": {
    "src/data/*.generated.ts": ["types"],
    "src/spec/structure.generated.ts": ["types"]
  }
}
