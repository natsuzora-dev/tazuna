{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/service/**/*.ts", "test/load/**/*.ts", "test/validation/**/*.ts", "test/verify/**/*.ts"],
      "ignoreDependencies": ["@swc/core"],
      "vite": {
        "config": ["viewer/vite.config.ts"]
      }
    },
    "samples/todo/spec": {
      "entry": ["**/{scenarios,contract,automations,machines,explore,*Screen}.ts"]
    }
  },
  "ignoreBinaries": ["lake", "mkfifo"],
  "ignoreExportsUsedInFile": {
    "type": true
  },
  "ignoreIssues": {
    "src/data/*.generated.ts": ["types"],
    "src/spec/structure.generated.ts": ["types"]
  }
}
