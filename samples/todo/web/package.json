{
  "name": "todo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "rm -rf .traces && npm run typecheck && npm run test && npm run test:e2e && tazuna verify ../spec .traces",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "npm run db:migrate && vite dev",
    "start": "npm run db:migrate && node --env-file=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright install --only-shell chromium && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@todo/spec": "*",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@natsuzora-dev/tazuna": "file:../../..",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "nitro": "3.0.261103-rc",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
