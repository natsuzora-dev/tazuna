    Restricted(ForeignType) -> "Restricted.foreignType"
    Restricted(Recursion) -> "Restricted.recursion"
    Restricted(RecursiveType) -> "Restricted.recursiveType"
    Restricted(Incomparable) -> "Restricted.incomparable"
