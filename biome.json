{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": ["./lint/sameJson.grit"],
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!lean/lake-manifest.json", "!test/sim/**/*.expected.json"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "overrides": [
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["samples/todo/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/spec/**", "./**/spec/**"],
                    "message": "web imports the spec from @todo/spec, not from spec files"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["viewer/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "viewer imports tazuna by its package name, not files in tazuna/src"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/scenarios.ts", "test/lower.test.ts", "test/types.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
