#!/bin/sh
# Each kind of output line has one end-to-end case, a directory named after the kind. Fails when a kind has no case or
# a case names no kind, and runs each case as a user would: the launcher, run in a copy of the case's
# src/ (and snapshots/ and traces/, when the case has them) with the arguments in its args file, must print the case's
# stdout and exit with the code in its exit file. A case with written/ must leave a directory written/ equal to it,
# as explore and search write their traces there. A kind
# no spec can reach (a converter or launcher bug) has an ir.json instead of src/, which the engine reads directly.
# Every line a case expects names a kind and carries only the fields explain names for it.
# Usage: test/e2e/check <the kinds executable> <engine> <the Gleam package's build/dev directory>
set -eu
cd "$(dirname "$0")"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
kinds=$work/kinds
"$1" >"$kinds"
engine=$2
dev=$3
# shellcheck disable=SC2046 # one -pa directory per package
launch() { erl -noshell -pa $(printf '%s ' "$dev"/erlang/*/ebin) -eval 'tazuna:main()' -extra "$@"; }
status=0
"$1" --lines */stdout || status=1
while read -r kind; do
  [ -d "$kind" ] || { echo "e2e: kind $kind has no case. Add the directory test/e2e/$kind."; status=1; }
done <"$kinds"
for dir in */; do
  [ -d "$dir" ] || continue
  case=${dir%/}
  grep -qxF "$case" "$kinds" || { echo "e2e: test/e2e/$dir names no kind. Rename or remove it."; status=1; continue; }
  args=$(cat "$case/args")
  if [ -f "$case/ir.json" ]; then
    code=0
    # shellcheck disable=SC2086 # args holds words to split
    out=$("$engine" $args --ir "$case/ir.json") || code=$?
    [ "$out" = "$(cat "$case/stdout")" ] || { printf 'e2e: %s printed\n%s\n' "$case" "$out"; status=1; }
    [ "$code" = "$(cat "$case/exit")" ] || { echo "e2e: $case exited $code, expected $(cat "$case/exit")"; status=1; }
    continue
  fi
  mkdir "$work/$case"
  for part in src snapshots traces; do
    if [ -d "$case/$part" ]; then cp -R "$case/$part" "$work/$case/"; fi
  done
  code=0
  # shellcheck disable=SC2086 # args holds words to split
  out=$(cd "$work/$case" && TAZUNA_ENGINE="$engine" launch $args) || code=$?
  [ "$out" = "$(cat "$case/stdout")" ] || { printf 'e2e: %s printed\n%s\n' "$case" "$out"; status=1; }
  [ "$code" = "$(cat "$case/exit")" ] || { echo "e2e: $case exited $code, expected $(cat "$case/exit")"; status=1; }
  if [ -d "$case/written" ]; then
    diff -r "$case/written" "$work/$case/written" >/dev/null ||
      { echo "e2e: $case wrote other files than $case/written"; status=1; }
  fi
done
exit $status
