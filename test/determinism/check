#!/bin/sh
# prove's lines do not depend on how many solvers run at once, nor on --only beyond what it leaves out. The prove
# e2e spec with counterexamples to induction (of a step's target and of a response), proved from an empty cache with --jobs 1 and with
# --jobs 4, must print the same bytes and exit with the same code. The one where everything is proved, proved with
# --only, must print some of the full run's lines, each the same apart from `assumes`: an invariant --only leaves out
# is not proved in that run, so it is assumed. generate, run the same ways, must print the same lines and write the
# same files, and with --only the files it writes must be the full run's. A question that exhausts z3's resource limit
# is undecided the same way on a loaded machine: the e2e spec whose question does so, proved while the --jobs 4 run
# loads the machine, must print the e2e case's lines.
# Usage: test/determinism/check <engine> <the Gleam package's build/dev directory>
set -eu
here=$(cd "$(dirname "$0")" && pwd)
engine=$1
dev=$2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# shellcheck disable=SC2046 # one -pa directory per package
launch() {
  TAZUNA_ENGINE="$engine" erl -noshell -pa $(printf '%s ' "$dev"/erlang/*/ebin) -eval 'tazuna:main()' -extra "$@"
}
prove() {
  name=$1
  case=$2
  shift 2
  mkdir "$work/$name"
  cp -R "$here/../e2e/$case/src" "$work/$name/"
  code=0
  (cd "$work/$name" && launch prove m "$@" >out.jsonl) || code=$?
  echo "$code" >"$work/$name/exit"
}
prove one Prove.unproved --jobs 1
prove four Prove.unproved --jobs 4 &
loader=$!
prove loaded Undecided.unknown --jobs 4
wait "$loader"
if ! cmp -s "$work/loaded/out.jsonl" "$here/../e2e/Undecided.unknown/stdout"; then
  echo "determinism: a question past the solver's resource limit printed other lines on a loaded machine:"
  diff "$here/../e2e/Undecided.unknown/stdout" "$work/loaded/out.jsonl" || true
  exit 1
fi
if ! cmp -s "$work/one/out.jsonl" "$work/four/out.jsonl" || ! cmp -s "$work/one/exit" "$work/four/exit"; then
  echo "determinism: prove printed other lines or exited otherwise with --jobs 1 than with --jobs 4:"
  diff "$work/one/out.jsonl" "$work/four/out.jsonl" || true
  exit 1
fi
prove all Prove.proved
prove only Prove.proved --only "counter/add ensures"
strip() { sed 's/"assumes":\[[^]]*\],\{0,1\}//' "$1"; }
strip "$work/all/out.jsonl" >"$work/full"
strip "$work/only/out.jsonl" >"$work/kept"
[ -s "$work/kept" ] || { echo "determinism: prove --only printed no line"; exit 1; }
while IFS= read -r line; do
  grep -qxF "$line" "$work/full" || { printf 'determinism: prove --only printed a line the full run lacks:\n%s\n' "$line"; exit 1; }
done <"$work/kept"

generate() {
  name=$1
  shift
  mkdir "$work/$name"
  cp -R "$here/../e2e/Generate.reached/src" "$work/$name/"
  code=0
  (cd "$work/$name" && launch generate m written "$@" >out.jsonl) || code=$?
  echo "$code" >"$work/$name/exit"
}
generate gone --jobs 1
generate gfour --jobs 4
if ! cmp -s "$work/gone/out.jsonl" "$work/gfour/out.jsonl" || ! cmp -s "$work/gone/exit" "$work/gfour/exit" ||
  ! diff -r "$work/gone/written" "$work/gfour/written" >/dev/null; then
  echo "determinism: generate printed other lines, exited otherwise or wrote other files with --jobs 1 than with --jobs 4"
  exit 1
fi
generate gonly --only "counter/add invalid"
[ -s "$work/gonly/out.jsonl" ] || { echo "determinism: generate --only printed no line"; exit 1; }
while IFS= read -r line; do
  grep -qxF "$line" "$work/gone/out.jsonl" ||
    { printf 'determinism: generate --only printed a line the full run lacks:\n%s\n' "$line"; exit 1; }
done <"$work/gonly/out.jsonl"
for f in "$work/gonly/written"/*/*; do
  cmp -s "$f" "$work/gone/written/${f#"$work/gonly/written/"}" ||
    { echo "determinism: generate --only wrote $f unlike the full run"; exit 1; }
done
# A written trace is one verify passes.
(cd "$work/gone" && launch verify m written/counter >verify.jsonl) ||
  { echo "determinism: verify did not pass the traces generate wrote:"; cat "$work/gone/verify.jsonl"; exit 1; }
